# --- General ---
APP_ENV=development

# --- SQL database (metadata store) ---
DATABASE_URL=sqlite:///./data/app.db

# --- Qdrant (vector store, embedded/local mode - no server required) ---
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=documents

# --- Redis (chat memory) ---
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_HISTORY_MAX_TURNS=20

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM provider: "ollama" (free/local, default) or "openai" (paid) ---
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI settings (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG ---
TOP_K=4
